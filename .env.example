# CLIP Model
MODEL_ID=anhquanlam/clip-finetuned-deepfashion

# Qdrant
QDRANT_MODE=remote
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fashion_images
QDRANT_HNSW_EF=128
QDRANT_INDEXING_THRESHOLD=5000
QDRANT_FULL_SCAN_THRESHOLD=5000
SEARCH_MODE_DEFAULT=ann

# Indexing performance
INGEST_BATCH_SIZE=32
MINIO_UPLOAD_WORKERS=8
INDEX_FAST_METADATA_SKIP=true
INDEX_REPAIR_MISSING_OBJECTS=true

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fashion-images
MINIO_SECURE=false

# Legacy data paths (for migration)
LEGACY_IMAGES_PATH=./DeepFashion/images
LEGACY_INDEX_PATH=./DeepFashion/embed_data
CAPTIONS_PATH=./DeepFashion/captions.json

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENABLE_API_KEY_AUTH=false
API_KEY=
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_PIXELS=50000000
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp
