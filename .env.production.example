# Copy to .env.production and replace all secrets before deploying.

# CLIP Model
MODEL_ID=anhquanlam/clip-finetuned-deepfashion
DEVICE=

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
ENABLE_API_KEY_AUTH=true
API_KEY=replace-with-a-long-random-api-key
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_PIXELS=50000000
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp

# Qdrant
QDRANT_MODE=remote
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fashion_images
QDRANT_HNSW_EF=128
QDRANT_INDEXING_THRESHOLD=5000
QDRANT_FULL_SCAN_THRESHOLD=5000
QDRANT_UPSERT_BATCH_SIZE=100
SEARCH_MODE_DEFAULT=ann

# Indexing performance and jobs
INGEST_BATCH_SIZE=32
MINIO_UPLOAD_WORKERS=8
INDEX_FAST_METADATA_SKIP=true
INDEX_REPAIR_MISSING_OBJECTS=true
INDEXING_JOB_BACKEND=redis
REDIS_URL=redis://redis:6379/0
INDEXING_QUEUE_NAME=indexing
INDEXING_JOB_TIMEOUT_SECONDS=3600
INDEXING_JOB_RESULT_TTL_SECONDS=86400
INDEXING_JOB_FAILURE_TTL_SECONDS=604800

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-minio-access-key
MINIO_SECRET_KEY=replace-minio-secret-key
MINIO_BUCKET=fashion-images
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=replace-minio-root-user
MINIO_ROOT_PASSWORD=replace-minio-root-password

# Data paths inside the app/worker containers.
LEGACY_IMAGES_PATH=/data/images
LEGACY_INDEX_PATH=/data/embed_data
CAPTIONS_PATH=/data/captions.json
